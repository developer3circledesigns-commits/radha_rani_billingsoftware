# ===================================================================
# Radha Rani Hotel Portal - .gitignore
# ===================================================================
# Three rules drive everything below:
#   1. Never commit credentials, real bill PDFs, or logs.
#   2. Never commit database dumps or exports - they contain every bill
#      row, every user and every password_hash.
#   3. Never ignore the vendored FRONTEND libraries in
#      public/assets/vendor/ - they are required for the site to render.
#      Note the leading slash on "/vendor/" for exactly that reason.
#
# NOTE: a .gitignore is a safety net, not a guarantee. It can be
# overridden with "git add -f", and it cannot see secrets that are
# already in a commit. See DEPLOYMENT.md for the pre-push checklist.
# ===================================================================


# -------------------------------------------------------------------
# 1. Secrets and local configuration  (MOST IMPORTANT SECTION)
# -------------------------------------------------------------------
# Contains the hPanel database host / name / user / password. It is a
# template in the repo with every line commented out, but once someone
# fills in real credentials and commits, the password is in git history
# forever. Keep it untracked.
app/config/config.local.php
app/config/config.php

# Any .env file, in case one is added later. The app does not use one
# today, but these rules guarantee a mistake can never be committed or
# served.
.env
.env.*
!.env.example

# Local overrides of the shipped .htaccess / .user.ini
public/.htaccess.local
public/.user.ini.local
*.local.php

# TLS / SSH / deployment keys and keystores
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_rsa.pub
known_hosts
.netrc
.npmrc
.docker/
deploy.key

# Basic-auth password files
.htpasswd
*.htpasswd


# -------------------------------------------------------------------
# 2. Database dumps, exports and captured traffic
# -------------------------------------------------------------------
# A mysqldump contains every bill row, every user and every
# password_hash value. It must never be committed. The .htaccess already
# blocks *.sql over HTTP, but git ignores that entirely, so it is
# blocked here as well.
#
# The negation is what keeps the SCHEMA tracked: database/init.sql and
# database/migrations/*.sql are source code and have to be versioned.
*.sql
!database/**/*.sql

# Data exports - just as sensitive as a dump.
*.csv
*.tsv
*.xls
*.xlsx
*.ods

# HTTP archives replay the session: cookies, Authorization headers and
# bearer tokens are all inside a .har file.
*.har

# Local database files
*.db
*.sqlite
*.sqlite3


# -------------------------------------------------------------------
# 3. Runtime storage - bill PDFs, archives and logs
# -------------------------------------------------------------------
# Real customer bill PDFs must never enter the repository: they are
# private financial documents and they are large binaries that would
# bloat every clone. The directories are kept (via .gitkeep) and the app
# recreates the deeper branch/date folders on demand - see
# BillStorage::ensureStorageTree() and the LOG_PATH mkdir in
# app/bootstrap.php.
/storage/uploads/*
!/storage/uploads/.gitkeep
/storage/archive/*
!/storage/archive/.gitkeep
/storage/archive/bills/*
!/storage/archive/bills/.gitkeep
/storage/logs/*
!/storage/logs/.gitkeep

# Belt and braces: never track a PDF or a log anywhere in the tree.
*.pdf
*.log


# -------------------------------------------------------------------
# 4. Database volume
# -------------------------------------------------------------------
# Local MySQL data directory used by docker compose. Never version it.
/db/*
!/db/.gitkeep


# -------------------------------------------------------------------
# 5. Dependencies
# -------------------------------------------------------------------
# Root-only: this is where Composer would install. The leading slash is
# deliberate so it does NOT catch public/assets/vendor/, which holds the
# committed Bootstrap CSS/JS the site depends on.
#
# This project currently ships no Composer dependencies, so composer.json
# and composer.lock are deliberately NOT ignored - if they are ever added
# they belong in the repository. Only the installed packages are ignored.
/vendor/*
!/vendor/.gitkeep


# -------------------------------------------------------------------
# 6. Operating system noise
# -------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/
*.lnk


# -------------------------------------------------------------------
# 7. IDE and editor settings
# -------------------------------------------------------------------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.\#*
\#*\#


# -------------------------------------------------------------------
# 8. Logs, caches and temporary files
# -------------------------------------------------------------------
*.log
.cache/
.php-cs-fixer.cache
.phpunit.result.cache
tmp/
temp/
coverage/
*.tmp
*.bak
*.old
*.orig
*.save
*.rej


# -------------------------------------------------------------------
# 9. Deployment / upload leftovers
# -------------------------------------------------------------------
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
deploy*.txt


# -------------------------------------------------------------------
# 10. Files that SHOULD be committed - listed here as documentation
# -------------------------------------------------------------------
# Deliberately NOT ignored, because the site breaks without them:
#   .htaccess, public/.htaccess, storage/.htaccess   security rules
#   public/.user.ini                                PHP limits
#   public/assets/vendor/                           Bootstrap CSS/JS
#   app/, database/*.sql, docker/, tools/, public/   application code
#   DEPLOYMENT.md, README.md                        documentation

# Radha Rani Hotel Portal - project-root front controller
#
# WHY THIS FILE EXISTS
# Hostinger's Git integration can only deploy the repository root into the
# web root, but this project's entry points (login.php, index.php, owner/,
# branch/, api/, assets/) all live one level down in public/. Without the
# rewrite below, a flat deploy would answer /login.php with a 404 because
# the file is really at public/login.php.
#
# The rewrite makes public/ transparent: every public URL is served from
# public/ while the file stays physically there. That matters because the
# PHP entry points locate the application with dirname(__DIR__) and
# dirname(__DIR__, 2) - both of which resolve correctly as long as the
# script is executed from inside public/. No PHP changes are required.
#
# This file also keeps the private folders private, which is what allows the
# flat layout to be safe in the first place.
#
# NOTE: no "php_value" here on purpose. It requires mod_php and returns HTTP
# 500 on LiteSpeed / PHP-FPM, which is what shared hosts run. PHP limits live
# in public/.user.ini.

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# 0. Already inside public/ (an internal redirect from the rules below).
#    Stop here. Without this guard the catch-all rule re-matches the
#    rewritten URI and sends every request to index.php.
RewriteRule ^public(?:/|$) - [L]

# 1. Private folders: refuse before any rewriting can reach them. [F] is a
#    hard 403. These patterns are matched per-directory, so they stay correct
#    when the app is installed in a sub-directory.
RewriteRule ^(?:app|storage|database|tools|docker|db|vendor)(?:/|$) - [F,L]

# 2. Dotfiles (.env, .git, .htaccess itself).
RewriteRule (?:^|/)\.(?!well-known(?:/|$)) - [F,L]

# 3. A real file inside public/ is served directly, so PHP scripts execute
#    and static assets are delivered without a detour.
RewriteCond %{DOCUMENT_ROOT}/public/$1 -f
RewriteRule ^(.*)$ public/$1 [L]

# 4. A real directory inside public/ (owner/, branch/, api/, assets/).
RewriteCond %{DOCUMENT_ROOT}/public/$1 -d
RewriteRule ^(.*)$ public/$1 [L]

# 5. Everything else is a real route, so hand it to the front controller.
RewriteRule ^(.*)$ public/index.php [L]
</IfModule>

# Never serve dotfiles.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Fallback for hosts with mod_rewrite disabled. Anchored to the start of the
# path on purpose: a looser pattern such as "^/(.*/)?(app|vendor)(/|$)" also
# matches legitimate nested paths such as /assets/vendor/... and would strip
# the Bootstrap stylesheet from every page.
RedirectMatch 403 ^/(app|tools|database|docker|db|vendor|storage)(/|$)

# Block sensitive file types.
<FilesMatch "\.(sql|ini|log|md|json|sh|yml|yaml|bak|old|orig|save|swp|tar|gz|zip)$">
    Require all denied
</FilesMatch>

# Do not advertise the server version.
<IfModule mod_headers.c>
    Header always unset X-Powered-By
    Header always unset Server
</IfModule>

ServerSignature Off

# Security headers. SAMEORIGIN (not DENY) because the PDF preview is a
# same-origin iframe.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always set X-Permitted-Cross-Domain-Policies "none"
</IfModule>

# NOTE: "Options -Indexes" and "ServerTokens" are deliberately omitted.
# They need AllowOverride Options / server-config respectively and would
# otherwise raise a 500 on a locked-down host.

# Docker secrets for the local development stack.
#
# COPY this file to ".env" (same directory) and edit the values:
#   cp .env.example .env        (Linux / macOS / Git Bash)
#   copy .env.example .env      (Windows CMD)
#
# ".env" is listed in the project .gitignore, so it is never committed.
# Compose reads this file automatically - no extra flags needed.
#
# The defaults baked into docker-compose.yml (rootpass / radhapass) are
# fine for a laptop that is not reachable from the internet. Set real
# values here if you run the stack on a server or a shared machine.

# Password for the MySQL "root" account.
DB_ROOT_PASSWORD=rootpass

# Password for the "radha" application account.
DB_PASSWORD=radhapass
